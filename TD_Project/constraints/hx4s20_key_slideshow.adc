# HX4S20 / EG4S20BG256 pin assignments
# Clock and keys (all keys are active-low)
set_pin_assignment { clk   } { LOCATION = R7; IOSTANDARD = LVCMOS33; }
set_pin_assignment { rst_n } { LOCATION = C1; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key1  } { LOCATION = A2; IOSTANDARD = LVCMOS33; }
set_pin_assignment { key2  } { LOCATION = B2; IOSTANDARD = LVCMOS33; }
# HX4S20 HDL manual 2410 p18-19: physical K3/KEY3 = B1, active low.
set_pin_assignment { key3  } { LOCATION = B1; IOSTANDARD = LVCMOS33; }
set_pin_assignment { emergency_switch } { LOCATION = C5; IOSTANDARD = LVCMOS33; }
# SW3=C6, recorded board-manual mapping in yingji_scene_TODO.md.
set_pin_assignment { period_switch } { LOCATION = C6; IOSTANDARD = LVCMOS33; }
# HX4S20 HDL manual 2410 p18: SW2=C7, up=1 (show), down=0 (hide).
set_pin_assignment { waveform_switch } { LOCATION = C7; IOSTANDARD = LVCMOS33; }

# TF card, SPI mode
# HX4S20 HDL manual 2410 p13 and GPIO schematic: J1 pin 1=D14, pin 2=G11.
# Dedicated panel UART avoids paralleling screen TX with the board CH340 TX.
set_pin_assignment { uart_rx } { LOCATION = D14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { uart_tx } { LOCATION = G11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# Independent onboard CH340, verified against prior UART course ADC and schematic.
set_pin_assignment { pc_uart_rx } { LOCATION = F12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { pc_uart_tx } { LOCATION = D12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

set_pin_assignment { sd_ncs  } { LOCATION = A12; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_miso } { LOCATION = B14; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_dclk } { LOCATION = A14; IOSTANDARD = LVCMOS33; }
set_pin_assignment { sd_mosi } { LOCATION = A13; IOSTANDARD = LVCMOS33; }

# HDMI-B. EG4S20BG256 Bank 3 is fixed at 3.3 V by the internal SDRAM supply,
# so its differential HDMI outputs must use the 3.3 V differential standard.
# Only the P pin is constrained; TD assigns the paired N pin automatically.
set_pin_assignment { HDMI_D2_P  } { LOCATION = E1; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_D1_P  } { LOCATION = F1; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_D0_P  } { LOCATION = G5; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_CLK_P } { LOCATION = C3; IOSTANDARD = LVDS33; }
set_pin_assignment { HDMI_DDC_SCL } { LOCATION = P2; IOSTANDARD = LVCMOS33; }
set_pin_assignment { HDMI_DDC_SDA } { LOCATION = R2; IOSTANDARD = LVCMOS33; }

# Eight common-anode seven-segment digits. DIG segments are active-low;
# SEL digit enables are active-low through PNP drivers (manual figure 2-15).
# Put board switch SW6 in DIG position.
set_pin_assignment { seg_data[0] } { LOCATION = C15; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[1] } { LOCATION = C16; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[2] } { LOCATION = B6;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[3] } { LOCATION = A5;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[4] } { LOCATION = B5;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[5] } { LOCATION = A8;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[6] } { LOCATION = A7;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_data[7] } { LOCATION = A6;  IOSTANDARD = LVCMOS33; }

set_pin_assignment { seg_sel[0] } { LOCATION = F16; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[1] } { LOCATION = E16; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[2] } { LOCATION = E12; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[3] } { LOCATION = E10; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[4] } { LOCATION = C13; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[5] } { LOCATION = F10; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[6] } { LOCATION = E11; IOSTANDARD = LVCMOS33; }
set_pin_assignment { seg_sel[7] } { LOCATION = D11; IOSTANDARD = LVCMOS33; }

# HX4S20 HDL manual 2410 PDF p18: SW1=C8, up=1/down=0.
set_pin_assignment { clip_switch } { LOCATION = C8; IOSTANDARD = LVCMOS33; }
